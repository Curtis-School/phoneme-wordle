# Each app keeps its own .gitignore; this only covers the repo root.
.DS_Store
.env
.env.*
!.env.example
/node_modules
# The root package.json only forwards scripts and has no dependencies, so a lockfile
# here adds nothing and makes Next guess this folder is the workspace root.
/package-lock.json

# playwright output
/test-results
/playwright-report
/blob-report

# jmeter output
/testing/jmeter/results/
/testing/jmeter/results.md
